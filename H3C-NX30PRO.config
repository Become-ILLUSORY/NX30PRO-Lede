#######################################################################
#                             MISC                                    #
#######################################################################

# CONFIG_AFALG_FALLBACK is not set
# CONFIG_PKG_CHECK_FORMAT_SECURITY is not set
# CONFIG_PKG_FORTIFY_SOURCE_1 is not set
CONFIG_PKG_FORTIFY_SOURCE_2=y
# CONFIG_OPENSSL_ENGINE_BUILTIN is not set
# CONFIG_OPENSSL_PREFER_CHACHA_OVER_GCM is not set
CONFIG_OPENSSL_WITH_NPN=y
# CONFIG_PACKAGE_TURBOACC_INCLUDE_FLOW_OFFLOADING is not set
CONFIG_PACKAGE_TURBOACC_INCLUDE_NO_FASTPATH=y
# CONFIG_WOLFSSL_HAS_ECC25519 is not set

#######################################################################
#        honk 运行时依赖（由 openwrt.daeuniverse.org 的 packa    )   #
#        Makefile DEPENDS 反推，必须编进固件（kmod 不能跨源装）      #
#######################################################################
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

#######################################################################
#        honk 需要的内核选项（自编译内核无 BTF，必须自带）           #
#######################################################################
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_NETKIT=y

#######################################################################
#                    ZRAM 压缩算法（zstd）                            #
#######################################################################
# 后端：同时编入 zstd 与 lzo（kmod-lib-zstd / kmod-lib-lzo 自动拉入）
CONFIG_KERNEL_ZRAM_BACKEND_ZSTD=y
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
# 默认压缩器只能选一个（kconfig choice）：zstd
CONFIG_KERNEL_ZRAM_DEF_COMP_ZSTD=y
# CONFIG_KERNEL_ZRAM_DEF_COMP_LZORLE is not set
# CONFIG_KERNEL_ZRAM_DEF_COMP_LZO is not set
# CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4 is not set
# CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4HC is not set

#######################################################################
#             BBR 配套：fq 队列规则（kmod-sched 提供）                #
#######################################################################
# sysctl-tcp-bbr.conf 只设了 tcp_congestion_control=bbr，没设 default_qdisc。
# CONFIG_NET_SCH_FQ 属于 KernelPackage/sched（不在 kmod-sched-core 里），
# 装上后可以把 fq 设为默认 qdisc，让 BBR 走 fq 精确节拍。
# 不装也能跑：6.12 的 TCP 内部节拍（internal pacing，4.20+）是合格的回退。
CONFIG_PACKAGE_kmod-sched=y

#######################################################################
#              squashfs 块大小（提升压缩率）                          #
#######################################################################
# 树里默认 256 KiB。实测 19MB 二进制：256K=6.71MB → 1M=6.36MB（省 5%）
# 代价：每块解压需约 1MB 缓冲，256MB 机器无压力。可选值 4~1024。
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=1024
# 压缩算法保持 xz（实测全场最优，无更优选项）
CONFIG_TARGET_ROOTFS_SQUASHFS=y

#######################################################################
#                          natmap                                    #
#######################################################################
# heiher/natmap：full cone NAT 下做 TCP/UDP 端口映射（打洞/保活）
CONFIG_PACKAGE_natmap=y
CONFIG_PACKAGE_luci-app-natmap=y
CONFIG_PACKAGE_luci-i18n-natmap-zh-cn=y
